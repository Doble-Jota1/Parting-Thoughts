# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

PartingThoughts/Build/*
PartingThoughts/Saved/*
PartingThoughts/Intermediate/*
PartingThoughts/DerivedDataCache/*

Builds/*
Game\ Build/*
Game\ Build.zip
PartingThoughts_New/*
PartingThoughts/*

Parting-Thoughts-main/PartingThoughts/Build/*
Parting-Thoughts-main/PartingThoughts/Intermediate/*
